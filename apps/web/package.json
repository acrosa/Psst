{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "react-router dev",
		"build": "react-router build",
		"vercel-build": "node scripts/migrate-on-deploy.mjs && react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "react-router typegen && tsc",
		"lint": "biome check .",
		"format": "biome format . --write",
		"db:setup": "tsx scripts/db-setup.ts",
		"db:generate": "drizzle-kit generate",
		"db:generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"worker": "tsx workers/index.ts",
		"test:e2e": "tsx e2e/setup-db.ts && playwright test",
		"test:e2e:ui": "tsx e2e/setup-db.ts && playwright test --ui",
		"test:e2e:report": "playwright show-report"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.957.0",
		"@react-router/node": "^7.9.2",
		"@react-router/serve": "^7.9.2",
		"@xyflow/react": "^12.8.0",
		"apns2": "^12.2.0",
		"better-auth": "~1.4.1",
		"better-sqlite3": "^12.5.0",
		"blurhash": "^2.0.5",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.44.7",
		"isbot": "^5.1.31",
		"lucide-react": "^1.34.0",
		"pg": "^8.16.3",
		"pg-boss": "^10.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^7.9.2",
		"sharp": "^0.34.5",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@playwright/test": "^1.56.0",
		"@react-router/dev": "^7.9.2",
		"@tailwindcss/vite": "^4.1.13",
		"@types/better-sqlite3": "^7.6.13",
		"@types/pg": "^8.15.4",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"drizzle-kit": "^0.31.6",
		"tailwindcss": "^4.1.13",
		"tsx": "^4.21.0",
		"typescript": "^5.8.0",
		"vite": "^6.3.5",
		"vite-tsconfig-paths": "^5.1.4"
	}
}
