# psst — environment
# Copy to .env — the defaults below work with `docker compose up -d` out of the box.

NODE_ENV=development

# --- Database -----------------------------------------------------------------
# PostgreSQL for dev/prod. Set USE_SQLITE=true instead to run without Postgres
# (what the E2E suite does).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/psst
# USE_SQLITE=true

# --- Auth (Better Auth) ---------------------------------------------------------
BETTER_AUTH_SECRET=dev-secret-must-be-32-characters-long!
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Social sign-in — the primary way in (email/password remains as fallback).
# Google: OAuth client from console.cloud.google.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Apple: Services ID + generated client secret JWT (developer.apple.com)
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# --- Jobs ----------------------------------------------------------------------
# Jobs (unfurling, image processing) run inline by default — no worker needed.
# Set JOBS_MODE=queue to enqueue via pg-boss instead and run `pnpm worker`.
# JOBS_MODE=queue

# --- Email ---------------------------------------------------------------------
# Invite emails log to the console unless a Resend key is set.
# RESEND_API_KEY=
# EMAIL_FROM=psst <hello@yourdomain.com>

# --- Storage -------------------------------------------------------------------
# Image uploads go to local disk (data/uploads) unless S3 is configured.
# Works with Cloudflare R2, MinIO (docker compose), or any S3-compatible bucket.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=psst-uploads
# S3_ACCESS_KEY_ID=psst
# S3_SECRET_ACCESS_KEY=psst-secret
# S3_PUBLIC_URL=http://localhost:9000/psst-uploads

# --- Analytics (LogSnag, optional) ----------------------------------------------
# LOGSNAG_TOKEN=
# LOGSNAG_PROJECT=psst
